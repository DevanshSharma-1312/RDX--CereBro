        type: rx.audio_type || 'binaural',
        carrier: rx.carrier_frequency_hz || 174,
        beat: rx.beat_frequency_hz || 5.5,
        duration: rx.duration_minutes || 15,
        volume: rx.volume || 0.35,
        badge: 'Adaptive'
      };
    }

    // --- Player Management & Synchronisation ---

    applyProfileToPlayer(profKey) {
      const p = this.profiles[profKey] || this.profiles.custom_ai;
      this.selectedProfile = profKey;

      // Update sliders & engine
      this.sliderCarrier.value = p.carrier;
      this.valCarrier.textContent = `${p.carrier} Hz`;
      this.engine.setCarrier(p.carrier);

      this.sliderBeat.value = p.beat;
      this.valBeat.textContent = `${p.beat} Hz`;
      this.engine.setBeat(p.beat);

      this.sliderDuration.value = p.duration;
      this.valDuration.textContent = `${p.duration} Min`;
      this.engine.setDuration(p.duration);

      this.sliderVolume.value = Math.round(p.volume * 100);
      this.valVolume.textContent = `${Math.round(p.volume * 100)}%`;
      this.engine.setVolume(p.volume);

      this.engine.setType(p.type);
      this.updateTypeUI(p.type);

      // Update quick chips active state
      document.querySelectorAll('.st-quick-chips button[data-hz]').forEach(b => {
        b.classList.toggle('active', Number(b.dataset.hz) === p.carrier);
      });
      document.querySelectorAll('.st-quick-chips button[data-beat]').forEach(b => {
        b.classList.toggle('active', Number(b.dataset.beat) === p.beat);
      });

      this.updateTelemetryReadout();
    }

    updateTypeUI(type) {
      document.querySelectorAll('.st-type-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.type === type);
      });

      const isBinaural = type === 'binaural';
      const isIsochronic = type === 'isochronic';
      const needsBeat = isBinaural || isIsochronic;

      this.beatControlGroup.style.display = needsBeat ? 'flex' : 'none';
      this.headphoneNotice.style.display = isBinaural ? 'flex' : 'none';
      document.getElementById('stAudioTypeBadge').textContent = this.formatTypeLabel(type);
      this.updateTelemetryReadout();
    }

    updateTelemetryReadout() {
      const type = this.engine.currentType;
      const carrier = this.engine.carrierFreq;
      const beat = this.engine.beatFreq;

      if (type === 'binaural') {
        this.teleLeftEar.textContent = `${carrier.toFixed(1)} Hz`;
        this.teleRightEar.textContent = `${(carrier + beat).toFixed(1)} Hz`;
        this.teleBeatDiff.textContent = `${beat.toFixed(1)} Hz (${this.getBandNameForBeat(beat)})`;
      } else if (type === 'isochronic') {
        this.teleLeftEar.textContent = `${carrier.toFixed(1)} Hz (Pulse)`;
        this.teleRightEar.textContent = `${carrier.toFixed(1)} Hz (Pulse)`;
        this.teleBeatDiff.textContent = `${beat.toFixed(1)} Hz Pulse Rate`;
      } else if (type === 'ambient') {
        this.teleLeftEar.textContent = `${carrier.toFixed(1)} Hz (Pad)`;
        this.teleRightEar.textContent = `Brown Noise Ocean`;
        this.teleBeatDiff.textContent = `Atmospheric`;
      } else {
        this.teleLeftEar.textContent = `${carrier.toFixed(1)} Hz`;
        this.teleRightEar.textContent = `${carrier.toFixed(1)} Hz`;
        this.teleBeatDiff.textContent = `Pure Waveform`;
      }
    }

    handleTimerTick(remaining, total) {
      const mins = Math.floor(Math.max(0, remaining) / 60);
      const secs = Math.max(0, remaining) % 60;
      this.timerDigits.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

      // Circular Ring Progress
      if (this.timerProgressCircle) {
        const circumference = 2 * Math.PI * 44; // 276.46
        const progress = Math.max(0, remaining / total);
        this.timerProgressCircle.style.strokeDashoffset = (circumference * (1 - progress)).toFixed(2);
      }
    }

    handleAudioStateChange(state) {
      this.playbackStateLabel.textContent = state;

      if (state === 'PLAYING') {
        this.playIcon.style.display = 'none';
        this.pauseIcon.style.display = 'block';
        document.getElementById('stStageStatusText').textContent = 'Live Audio-Reactive Resonance';
      } else {
        this.playIcon.style.display = 'block';
        this.pauseIcon.style.display = 'none';
        document.getElementById('stStageStatusText').textContent = state === 'PAUSED' ? 'Paused' : '3D Neural Simulation';
      }
    }

    handleSessionComplete() {
      // Record completed session to localStorage
      this.history.logSession({
        profile: this.profiles[this.selectedProfile]?.name || 'Adaptive Session',
        audioType: this.engine.currentType,
        carrierHz: this.engine.carrierFreq,
        beatHz: this.engine.beatFreq,
        durationMinutes: this.engine.durationMinutes,
        completed: true
      });
      this.updateHistoryBadge();

      alert('🎉 Sound Therapy Session Completed!\nYour relaxing session has ended smoothly.');
    }

    // --- Session History & Modals ---

    openHistoryModal() {
      const stats = this.history.getStats();
      this.statTotalSessions.textContent = stats.totalSessions;
      this.statTotalTime.textContent = stats.totalTimeFormatted;
      this.statCompleted.textContent = stats.completed;

      if (stats.recent.length === 0) {
        this.historyTableBody.innerHTML = `
          <tr>
            <td colspan="4" style="text-align: center; color: var(--st-ink-muted); padding: 24px;">No session history recorded yet.</td>
          </tr>
        `;
      } else {
        this.historyTableBody.innerHTML = stats.recent.map(r => `
          <tr>
            <td>${r.date} ${r.time}</td>
            <td><strong>${this.escapeHTML(r.profile)}</strong></td>
            <td>${r.durationMinutes} min</td>
            <td><span class="st-format-pill" style="font-size:10px;">${r.completed ? 'Completed' : 'Partial'}</span></td>
          </tr>
        `).join('');
      }

      this.historyModal.style.display = 'flex';
    }

    closeHistoryModal() {
      this.historyModal.style.display = 'none';
    }

    updateHistoryBadge() {
      const stats = this.history.getStats();
      if (stats.totalSessions > 0) {
        this.historyBadge.textContent = stats.totalSessions;
        this.historyBadge.style.display = 'inline-flex';
      } else {
        this.historyBadge.style.display = 'none';
      }
    }

    // --- Gemini API Key Modal & Status ---

    openApiKeyModal() {
      this.inputApiKey.value = this.ai.apiKey || '';
      this.apiKeyTestResult.style.display = 'none';
      this.apiKeyModal.style.display = 'flex';
    }

    closeApiKeyModal() {
      this.apiKeyModal.style.display = 'none';
      this.updateApiStatusUI();
    }

    saveApiKeyFromInput() {
      const val = this.inputApiKey.value.trim();
      if (val) {
        this.ai.saveApiKey(val);
        alert('Gemini API key saved successfully.');
      } else {
        this.ai.clearApiKey();
        alert('API key cleared.');
      }
      this.closeApiKeyModal();
    }

    async testApiKeyConnection() {
      const key = this.inputApiKey.value.trim();
      if (!key) {
        this.apiKeyTestResult.style.display = 'block';
        this.apiKeyTestResult.style.background = '#FEF2F2';
        this.apiKeyTestResult.style.color = '#B91C1C';
        this.apiKeyTestResult.textContent = 'Please enter an API key to test.';
        return;
      }

      this.apiKeyTestResult.style.display = 'block';
      this.apiKeyTestResult.style.background = '#EFF6FF';
      this.apiKeyTestResult.style.color = '#1D4ED8';
      this.apiKeyTestResult.textContent = 'Testing connection with Gemini 1.5/2.0 Flash...';

      try {
        const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${key}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contents: [{ parts: [{ text: 'Respond with: OK' }] }] })
        });
        if (res.ok) {
          this.apiKeyTestResult.style.background = '#ECFDF5';
          this.apiKeyTestResult.style.color = '#047857';
          this.apiKeyTestResult.textContent = '✓ Connection successful! Your Gemini API key is valid.';
        } else {
          const d = await res.json().catch(() => ({}));
          this.apiKeyTestResult.style.background = '#FEF2F2';
          this.apiKeyTestResult.style.color = '#B91C1C';
          this.apiKeyTestResult.textContent = `✗ Connection failed: ${d.error?.message || res.statusText}`;
        }
      } catch (err) {
        this.apiKeyTestResult.style.background = '#FEF2F2';
        this.apiKeyTestResult.style.color = '#B91C1C';
        this.apiKeyTestResult.textContent = '✗ Network test error: ' + err.message;
      }
    }

    updateApiStatusUI() {
      if (this.ai.hasKey()) {
        this.apiStatusDot.className = 'st-dot';
        this.apiStatusText.textContent = 'Gemini: Active';
      } else {
        this.apiStatusDot.className = 'st-dot warning';
        this.apiStatusText.textContent = 'Gemini: Demo';
      }
    }

    // --- Helpers ---

    formatTypeLabel(type) {
      switch (type) {
        case 'binaural': return 'Binaural Beats';
        case 'isochronic': return 'Isochronic Tones';
        case 'ambient': return 'Ambient Sound';
        case 'pure_tone': return 'Pure Tone';
        default: return 'Binaural Beats';
      }
    }

    getBandNameForBeat(hz) {
      if (hz < 4.0) return 'Delta (δ)';
      if (hz < 8.0) return 'Theta (θ)';
      if (hz < 13.0) return 'Alpha (α)';
      if (hz < 30.0) return 'Beta (β)';
      return 'Gamma (γ)';
    }

    escapeHTML(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
  }

  // Self-boot when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      window.CereBroSoundTherapy = new SoundTherapyApp();
    });
  } else {
    window.CereBroSoundTherapy = new SoundTherapyApp();
  }
})();

    </script>
  </body>
</html>
