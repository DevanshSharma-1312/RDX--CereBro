      this.currentRot = { x: 0.15, y: -0.3 };
      this.zoom = 4.2;

      this.rafId = null;
      this.init();
    }

    init() {
      if (typeof THREE === 'undefined') {
        console.warn('Three.js not loaded for Brain3D');
        return;
      }

      const rect = this.canvas.getBoundingClientRect();
      const width = rect.width || 600;
      const height = rect.height || 450;

      // Renderer
      this.renderer = new THREE.WebGLRenderer({
        canvas: this.canvas,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance'
      });
      this.renderer.setSize(width, height);
      this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

      // Scene & Camera
      this.scene = new THREE.Scene();
      this.camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);
      this.camera.position.set(0, 0, this.zoom);

      this.brainGroup = new THREE.Group();
      this.scene.add(this.brainGroup);

      // Lights
      const ambLight = new THREE.AmbientLight(0x1e293b, 1.2);
      this.scene.add(ambLight);

      const blueLight = new THREE.DirectionalLight(0x4285f4, 1.8);
      blueLight.position.set(4, 5, 4);
      this.scene.add(blueLight);

      const violetLight = new THREE.PointLight(0xa78bfa, 2.2, 20);
      violetLight.position.set(-4, -2, 3);
      this.scene.add(violetLight);

      // Build Brain Components
      this.buildCorticalPointCloud();
      this.buildSynapticNetwork();
      this.buildPulsatingWaveRings();

      // Mouse & Touch Controls
      this.setupControls();

      // Resize Observer
      this.resizeObserver = new ResizeObserver(() => this.onResize());
      this.resizeObserver.observe(this.canvas.parentElement);

      this.animate();
    }

    buildCorticalPointCloud() {
      // 16,000 anatomical point cloud coordinates
      const N = 16000;
      const positions = new Float32Array(N * 3);
      const colors = new Float32Array(N * 3);
      const sizes = new Float32Array(N);

      const colorBlue = new THREE.Color(0x4285F4);
      const colorViolet = new THREE.Color(0xA78BFA);
      const colorCyan = new THREE.Color(0x93C5FD);

      let seed = 42;
      const rng = () => {
        seed = (seed * 16807) % 2147483647;
        return (seed - 1) / 2147483646;
      };

      for (let i = 0; i < N; i++) {
        // Dual Hemispheres with longitudinal fissure
        const side = (i % 2 === 0) ? 1 : -1;
        const u = rng() * 2 - 1;
        const theta = rng() * Math.PI * 2;
        const rBase = Math.sqrt(Math.max(0, 1 - u * u));

        // Anatomical Brain Shaping (Frontal lobe, Occipital taper, Temporal curvature)
        let x = rBase * Math.cos(theta) * 0.76;
        let y = u * 0.92;
        let z = rBase * Math.sin(theta) * 1.15;

        // Hemispheric Fissure Separation
        x = x * 0.88 + side * 0.14;

        // Gyri / Sulci Fractal Convolutions
        const folds = 0.08 * (Math.sin(x * 12.0) * Math.cos(y * 10.0) + Math.sin(z * 14.0));
        x += folds * Math.cos(theta);
        y += folds * 0.8;
        z += folds * Math.sin(theta);

        // Cerebellum bulge underneath
        if (z < -0.4 && y < -0.3) {
          x *= 1.12;
          y *= 1.05;
        }

        positions[i * 3] = x * 1.4;
        positions[i * 3 + 1] = y * 1.4;
        positions[i * 3 + 2] = z * 1.4;

        // Color gradient: Frontal = Blue, Subcortical = Cyan, Occipital = Violet
        const lerpFactor = (z + 1.2) / 2.4;
        const col = colorBlue.clone().lerp(colorViolet, lerpFactor);
        if (Math.abs(x) < 0.25) col.lerp(colorCyan, 0.4);

        colors[i * 3] = col.r;
        colors[i * 3 + 1] = col.g;
        colors[i * 3 + 2] = col.b;

        sizes[i] = 0.024 + rng() * 0.018;
      }

      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
      geometry.setAttribute('size', new THREE.BufferAttribute(sizes, 1));

      // Custom Shader Material for glowing soft particles
      const material = new THREE.PointsMaterial({
        size: 0.038,
        vertexColors: true,
        transparent: true,
        opacity: 0.85,
        blending: THREE.AdditiveBlending
      });

      this.pointCloud = new THREE.Points(geometry, material);
      this.brainGroup.add(this.pointCloud);
    }

    buildSynapticNetwork() {
      // 3D Splines connecting neural hubs (Frontal, Motor, Sensory, Occipital)
      const hubs = [
        new THREE.Vector3(-0.5, 0.4, 0.8), // Fp1
        new THREE.Vector3(0.5, 0.4, 0.8),  // Fp2
        new THREE.Vector3(-0.7, 0.0, 0.0), // T3
        new THREE.Vector3(0.7, 0.0, 0.0),  // T4
        new THREE.Vector3(-0.4, 0.7, 0.1), // C3
        new THREE.Vector3(0.4, 0.7, 0.1),  // C4
        new THREE.Vector3(-0.4, -0.2, -0.9), // O1
        new THREE.Vector3(0.4, -0.2, -0.9)  // O2
      ];

      const lineMaterial = new THREE.LineBasicMaterial({
        color: 0x93C5FD,
        transparent: true,
        opacity: 0.35,
        blending: THREE.AdditiveBlending
      });

      const linesGroup = new THREE.Group();
      for (let i = 0; i < hubs.length; i++) {
        for (let j = i + 1; j < hubs.length; j++) {
          if (hubs[i].distanceTo(hubs[j]) < 1.7) {
            const curve = new THREE.QuadraticBezierCurve3(
              hubs[i],
              new THREE.Vector3(0, 0.2, 0), // Central limbic bend
              hubs[j]
            );
            const points = curve.getPoints(24);
            const geom = new THREE.BufferGeometry().setFromPoints(points);
            const line = new THREE.Line(geom, lineMaterial);
            linesGroup.add(line);
          }
        }
      }
      this.brainGroup.add(linesGroup);
      this.synapseLines = linesGroup;

      // Travelling Electrical Sparks along synapses
      const sparkCount = 80;
      const sparkGeom = new THREE.BufferGeometry();
      const sparkPositions = new Float32Array(sparkCount * 3);
      sparkGeom.setAttribute('position', new THREE.BufferAttribute(sparkPositions, 3));

      const sparkMat = new THREE.PointsMaterial({
        color: 0xFFFFFF,
        size: 0.055,
        transparent: true,
        opacity: 0.95,
        blending: THREE.AdditiveBlending
      });
      this.neuralParticles = new THREE.Points(sparkGeom, sparkMat);
      this.brainGroup.add(this.neuralParticles);
      this.sparkData = Array.from({ length: sparkCount }, () => ({
        progress: Math.random(),
        speed: 0.005 + Math.random() * 0.015,
        h1: Math.floor(Math.random() * hubs.length),
        h2: Math.floor(Math.random() * hubs.length)
      }));
      this.hubs = hubs;
    }

    buildPulsatingWaveRings() {
      // 3 Expanding holographic rings around the brain
      this.waveRings = [];
      for (let r = 0; r < 3; r++) {
        const ringGeom = new THREE.RingGeometry(1.6 + r * 0.3, 1.63 + r * 0.3, 64);
        const ringMat = new THREE.MeshBasicMaterial({
          color: 0x4285F4,
          side: THREE.DoubleSide,
          transparent: true,
          opacity: 0.25 - r * 0.06,
          blending: THREE.AdditiveBlending
        });
        const ring = new THREE.Mesh(ringGeom, ringMat);
        ring.rotation.x = Math.PI / 2 + (r - 1) * 0.15;
        this.brainGroup.add(ring);
        this.waveRings.push({ mesh: ring, baseScale: 1.0, offset: r * 0.33 });
      }
    }

    setupControls() {
      const getPos = e => {
        if (e.touches && e.touches.length > 0) {
          return { x: e.touches[0].clientX, y: e.touches[0].clientY };
        }
        return { x: e.clientX, y: e.clientY };
      };

      const start = e => {
        this.isDragging = true;
        this.prevMouse = getPos(e);
      };

      const move = e => {
        if (!this.isDragging) return;
        const pos = getPos(e);
        const dx = pos.x - this.prevMouse.x;
        const dy = pos.y - this.prevMouse.y;
        this.targetRot.y += dx * 0.008;
        this.targetRot.x += dy * 0.008;
        this.prevMouse = pos;
      };

      const end = () => {
        this.isDragging = false;
      };

      this.canvas.addEventListener('mousedown', start);
      window.addEventListener('mousemove', move);
      window.addEventListener('mouseup', end);

      this.canvas.addEventListener('touchstart', start, { passive: true });
      window.addEventListener('touchmove', move, { passive: true });
      window.addEventListener('touchend', end);

      // Wheel Zoom
      this.canvas.addEventListener('wheel', e => {
        e.preventDefault();
        this.zoom = Math.min(6.5, Math.max(2.5, this.zoom + e.deltaY * 0.003));
        this.camera.position.z = this.zoom;
      }, { passive: false });
    }

    resetCamera() {
      this.targetRot = { x: 0.15, y: -0.3 };
      this.zoom = 4.2;
      this.camera.position.set(0, 0, this.zoom);
    }

    onResize() {
      if (!this.canvas || !this.renderer || !this.camera) return;
      const rect = this.canvas.parentElement.getBoundingClientRect();
      const width = rect.width;
      const height = rect.height;
      this.camera.aspect = width / height;
      this.camera.updateProjectionMatrix();
      this.renderer.setSize(width, height);
    }

    connectAudioAnalyser(analyser) {
      this.analyser = analyser;
    }

    animate() {
      this.rafId = requestAnimationFrame(() => this.animate());

      const time = performance.now() * 0.001;

      // Audio Reactivity Calculation
      let audioAmp = 0;
      if (this.analyser) {
        this.analyser.getByteFrequencyData(this.freqData);
        let sum = 0;
        for (let i = 0; i < 32; i++) sum += this.freqData[i];
        audioAmp = (sum / 32) / 255; // Normalized 0..1
      }

      // Smooth Rotation Lerp
      if (!this.isDragging) {
        this.targetRot.y += 0.003; // Gentle auto-rotation
      }
      this.currentRot.x += (this.targetRot.x - this.currentRot.x) * 0.08;
      this.currentRot.y += (this.targetRot.y - this.currentRot.y) * 0.08;
      this.brainGroup.rotation.x = this.currentRot.x;
      this.brainGroup.rotation.y = this.currentRot.y;

      // Breathing Illumination + Audio Reactivity
      const breath = 1.0 + Math.sin(time * 1.5) * 0.03 + audioAmp * 0.12;
      this.brainGroup.scale.set(breath, breath, breath);

      if (this.pointCloud) {
        this.pointCloud.material.opacity = 0.75 + Math.sin(time * 2) * 0.08 + audioAmp * 0.25;
        this.pointCloud.material.size = 0.036 + audioAmp * 0.016;
      }

      // Update Neural Action Potential Sparks
      if (this.neuralParticles && this.sparkData && this.hubs) {
        const positions = this.neuralParticles.geometry.attributes.position.array;
        for (let s = 0; s < this.sparkData.length; s++) {
          const item = this.sparkData[s];
          item.progress += item.speed * (1.0 + audioAmp * 2.0);
          if (item.progress >= 1.0) {
            item.progress = 0;
            item.h1 = Math.floor(Math.random() * this.hubs.length);
            item.h2 = Math.floor(Math.random() * this.hubs.length);
          }
          const p1 = this.hubs[item.h1];
          const p2 = this.hubs[item.h2];
          positions[s * 3] = p1.x + (p2.x - p1.x) * item.progress;
          positions[s * 3 + 1] = p1.y + (p2.y - p1.y) * item.progress;
          positions[s * 3 + 2] = p1.z + (p2.z - p1.z) * item.progress;
        }
        this.neuralParticles.geometry.attributes.position.needsUpdate = true;
      }

      // Pulsate Holographic Wave Rings
      this.waveRings.forEach(item => {
        const pulse = ((time * 0.8 + item.offset) % 1.0);
        const scale = 1.0 + pulse * 0.45 + audioAmp * 0.2;
        item.mesh.scale.set(scale, scale, scale);
        item.mesh.material.opacity = Math.max(0, (1.0 - pulse) * 0.35 * (0.6 + audioAmp));
      });

      this.renderer.render(this.scene, this.camera);
    }

    dispose() {
      if (this.rafId) cancelAnimationFrame(this.rafId);
      if (this.resizeObserver) this.resizeObserver.disconnect();
      if (this.renderer) this.renderer.dispose();
    }
  }


