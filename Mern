      this.bandThetaEl.textContent = bi.theta || 'Not reported';
      this.bandAlphaEl.textContent = bi.alpha || 'Not reported';
      this.bandBetaEl.textContent = bi.beta || 'Not reported';
      this.bandGammaEl.textContent = bi.gamma || 'Not reported';

