  flex-direction: column;
  gap: 14px;
}
.st-file-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}
.st-file-info {
  display: flex;
  align-items: center;
  gap: 12px;
}
.st-file-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: #EAF4FF;
  color: var(--st-primary-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 13px;
