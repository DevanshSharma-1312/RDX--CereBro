  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--st-primary-blue);
}
.st-dropzone h3 {
  font-size: 18px;
  font-weight: 600;
  margin: 0 0 6px;
  color: var(--st-ink);
}
.st-dropzone p {
