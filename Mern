  align-items: center;
  justify-content: space-between;
}
.st-band-name {
  font-weight: 700;
  font-size: 13px;
  color: var(--st-ink);
}
.st-band-range {
  font-size: 11px;
  color: var(--st-ink-light);
  font-family: monospace;
}
.st-band-desc {
  font-size: 12px;
  color: var(--st-ink-muted);
  line-height: 1.35;
  margin: 0;
  flex: 1;
}

