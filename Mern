    // --- File Upload & Preview ---

    async handleFileSelection(file) {
      if (!file) return;

      const validTypes = ['application/pdf', 'image/png', 'image/jpeg', 'image/jpg', 'text/plain'];
      const ext = file.name.split('.').pop().toLowerCase();
      const validExts = ['pdf', 'png', 'jpg', 'jpeg', 'txt'];

      if (!validExts.includes(ext) && !validTypes.includes(file.type)) {
        alert('Unsupported file format. Please upload a PDF, PNG, JPG, JPEG, or TXT report.');
        return;
      }

      this.currentFile = file;
      this.fileNameEl.textContent = file.name;
      this.fileSizeEl.textContent = (file.size / 1024).toFixed(1) + ' KB';
      this.fileIconEl.textContent = ext.toUpperCase();

      this.dropzone.style.display = 'none';
      this.previewCard.style.display = 'flex';
      this.previewContent.innerHTML = '<em>Generating preview...</em>';

      // Generate Preview based on file format
      if (ext === 'txt') {
        const text = await file.text();
        this.extractedText = text;
        this.previewContent.innerHTML = `<pre style="margin:0; font-family:monospace; white-space:pre-wrap;">${this.escapeHTML(text.slice(0, 1200))}</pre>`;
      } else if (['png', 'jpg', 'jpeg'].includes(ext)) {
        const url = URL.createObjectURL(file);
        this.previewContent.innerHTML = `<img src="${url}" class="st-preview-img" alt="Report Preview" />`;
        this.extractedText = `[Uploaded image report: ${file.name}, size: ${file.size} bytes]`;
      } else if (ext === 'pdf') {
        try {
          if (window.pdfjsLib) {
            const arrayBuffer = await file.arrayBuffer();
            const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
            let extracted = '';
            for (let i = 1; i <= Math.min(pdf.numPages, 5); i++) {
              const page = await pdf.getPage(i);
              const content = await page.getTextContent();
              extracted += `--- Page ${i} ---\n` + content.items.map(it => it.str).join(' ') + '\n\n';
            }
            this.extractedText = extracted;
            this.previewContent.innerHTML = `
              <div style="font-weight:600; margin-bottom:6px; color:var(--st-primary-blue);">PDF Document: ${pdf.numPages} Page(s) Extracted</div>
              <pre style="margin:0; font-family:monospace; white-space:pre-wrap; font-size:11.5px;">${this.escapeHTML(extracted.slice(0, 1000))}...</pre>
            `;
          } else {
            this.extractedText = `[PDF Document: ${file.name}]`;
            this.previewContent.innerHTML = `<p style="margin:0;">PDF uploaded: ${file.name} (${(file.size/1024).toFixed(1)} KB)</p>`;
          }
        } catch (e) {
          this.previewContent.innerHTML = `<p style="margin:0; color:var(--st-warning);">PDF loaded. Ready for AI analysis.</p>`;
          this.extractedText = `[PDF file: ${file.name}]`;
        }
      }
    }

    resetFileUpload() {
      this.currentFile = null;
      this.extractedText = '';
      this.fileInput.value = '';
      this.previewCard.style.display = 'none';
      this.dropzone.style.display = 'block';
    }

    async loadSampleReport() {
      this.loadingOverlay.style.display = 'flex';
      this.loadingStepText.textContent = 'Loading CereBro Ashu Sharma EEG Report (CB-6JY3BO)...';

      try {
        const res = await fetch('Report.pdf');
        if (res.ok) {
          const blob = await res.blob();
          const file = new File([blob], 'Report.pdf', { type: 'application/pdf' });
          await this.handleFileSelection(file);
        } else {
          // Fallback simulation if Report.pdf can't be fetched
          this.currentFile = { name: 'Report.pdf', size: 220753 };
          this.fileNameEl.textContent = 'Report.pdf';
          this.fileSizeEl.textContent = '220.8 KB';
          this.fileIconEl.textContent = 'PDF';
          this.dropzone.style.display = 'none';
          this.previewCard.style.display = 'flex';
          this.previewContent.innerHTML = `
            <div style="font-weight:600; margin-bottom:6px; color:var(--st-primary-blue);">Sample EEG Report: Ashu Sharma (CB-6JY3BO)</div>
            <pre style="margin:0; font-family:monospace; white-space:pre-wrap; font-size:11.5px;">Patient: Ashu Sharma | 8 Electrodes | Signal Quality: 98%
Delta: 79% | Theta: 10% | Alpha: 7% | Beta: 4% | Gamma: 0%
Pattern: Elevated slow-wave activity associated with mental fatigue.</pre>
          `;
        }
      } catch (e) {
        // Continue smoothly
      } finally {
        setTimeout(() => {
          this.loadingOverlay.style.display = 'none';
        }, 300);
      }
    }

    // --- AI Analysis Execution ---

    async startReportAnalysis() {
      if (!this.currentFile && !this.extractedText) {
        alert('Please upload a report file first.');
        return;
      }

      this.loadingOverlay.style.display = 'flex';
      this.loadingStepText.textContent = 'Initiating Gemini AI neural analysis...';

      try {
        let result;
        if (!this.ai.hasKey()) {
          // Seamless Demo Mode with pre-computed authentic sample analysis
          await new Promise(r => setTimeout(r, 600));
          this.loadingStepText.textContent = 'Evaluating Alpha, Beta, Theta, Delta & Gamma signatures...';
          await new Promise(r => setTimeout(r, 600));
          this.loadingStepText.textContent = 'Synthesizing adaptive acoustic parameters...';
          await new Promise(r => setTimeout(r, 500));
          result = this.ai.getSampleAnalysis();
        } else {
          result = await this.ai.analyzeReport(this.currentFile, this.extractedText, (step) => {
            this.loadingStepText.textContent = step;
          });
        }

        this.currentAnalysis = result;
        this.renderAnalysisDashboard(result);

        this.stepTabAnalysis.disabled = false;
        this.goToStep(2);
      } catch (err) {
        if (err.message === 'NO_API_KEY') {
          this.openApiKeyModal();
        } else {
          alert('AI Analysis failed: ' + err.message + '\n\nFalling back to sample demonstration analysis.');
          const fallback = this.ai.getSampleAnalysis();
          this.currentAnalysis = fallback;
          this.renderAnalysisDashboard(fallback);
          this.stepTabAnalysis.disabled = false;
          this.goToStep(2);
        }
      } finally {
        this.loadingOverlay.style.display = 'none';
      }
    }

    renderAnalysisDashboard(data) {
      this.analysisSummary.textContent = data.report_summary;

      // Pattern tags
      this.patternTagsContainer.innerHTML = '';
      (data.identified_patterns || []).forEach(pat => {
