<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>CereBro: live EEG monitoring</title>
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Schibsted+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --paper: #e9ecee;
        --sheet: #fafbfb;
        --ink: #16212b;
        --muted: #5b6873;
        --rule: #cbd2d8;
        --rule2: #e1e6ea;
        --stage: #d3d8dc;
        --g: #2f7d45;
        --c: #2a8c95;
        --b: #4a5ba8;
        --o: #a86a0c;
        --r: #c2402c;
        --tx: var(--ink);
        --t2: var(--muted);
        --ln: var(--rule);
        --bg: var(--paper);
        --sans:
          "Schibsted Grotesk", system-ui, -apple-system, "Segoe UI", sans-serif;
        --serif: "Newsreader", Georgia, "Times New Roman", serif;
        box-sizing: border-box;
        padding-top: env(safe-area-inset-top, 0px);
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      html {
        scroll-padding-top: env(safe-area-inset-top, 0px);
      }
      * {
        box-sizing: border-box;
      }
      [hidden] {
        display: none !important;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font: 14px/1.5 var(--sans);
        font-variant-numeric: tabular-nums;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }
      .m {
        font-variant-numeric: tabular-nums;
      }
      button,
      select,
      input {
        font: 500 13px var(--sans);
        color: var(--ink);
        background: #fff;
        border: 1px solid var(--rule);
        border-radius: 8px;
        padding: 0 12px;
        height: 34px;
      }
      button {
        cursor: pointer;
        transition:
          background 0.12s,
          border-color 0.12s;
      }
      button:hover:not(:disabled) {
        background: #eef1f3;
        border-color: #aeb8c0;
      }
      button:disabled {
        opacity: 0.38;
        cursor: default;
      }
      button.on {
        background: var(--ink);
        border-color: var(--ink);
        color: #fff;
      }
      button.on:hover:not(:disabled) {
        background: #243442;
      }
      :is(button, input, select, summary):focus-visible {
        outline: 2px solid var(--b);
        outline-offset: 2px;
      }
      input[type="range"] {
        padding: 0;
        height: 20px;
        accent-color: var(--ink);
        background: none;
        border: 0;
      }
      select {
        padding: 0 8px;
      }
      /* ---------- sign-in ---------- */
      #login {
        display: grid;
        grid-template-columns: minmax(320px, 5fr) 7fr;
        min-height: 100vh;
      }
      .in-form {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 48px clamp(24px, 6vw, 88px);
        background: var(--sheet);
      }
      .in-form h1 {
        font: 400 clamp(46px, 6vw, 72px)/0.95 var(--serif);
        letter-spacing: -0.02em;
        margin: 0 0 14px;
      }
      .in-form .lede {
        font: 400 19px/1.4 var(--serif);
        color: var(--muted);
        margin: 0 0 36px;
        max-width: 26ch;
      }
      #lf {
        display: flex;
        flex-direction: column;
        gap: 18px;
        max-width: 340px;
      }
      #lf label {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-weight: 600;
        font-size: 13px;
      }
      #lf input {
        height: 44px;
        font-size: 16px;
        font-weight: 400;
        border-radius: 10px;
        padding: 0 14px;
      }
      #lf button[type="submit"] {
        height: 46px;
        margin-top: 4px;
        background: var(--ink);
        color: #fff;
        border-color: var(--ink);
        font-size: 15px;
        border-radius: 10px;
      }
      #lf button[type="submit"]:hover {
        background: #243442;
      }
      #le {
        margin: 0;
        color: var(--r);
        min-height: 20px;
        font-size: 13px;
      }
      .in-note {
        margin-top: auto;
        padding-top: 40px;
        font-size: 12px;
        color: var(--muted);
        max-width: 40ch;
      }
      .in-art {
        position: relative;
        background: #dde2e6;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      #lc {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      .in-art svg {
        position: relative;
        width: min(420px, 70%);
        height: auto;
      }
      @media (max-width: 820px) {
        #login {
          grid-template-columns: 1fr;
        }
        .in-art {
          display: none;
        }
        .in-form {
          min-height: 100vh;
        }
      }
      /* ---------- dashboard shell ---------- */
      #dash {
        display: none;
      }
      .bar {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        flex-wrap: wrap;
        gap: 10px 22px;
        align-items: center;
        padding: 10px 24px;
        background: rgba(233, 236, 238, 0.92);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--rule);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font: 500 26px/1 var(--serif);
        letter-spacing: -0.01em;
        margin-right: 6px;
      }
      .status {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 12px;
        align-items: center;
        font-size: 13px;
        color: var(--muted);
        flex: 1;
        min-width: 260px;
      }
      #usr {
        color: var(--ink);
        font-weight: 600;
      }
      .bd {
        display: inline-block;
        font: 600 12px var(--sans);
        padding: 3px 10px;
        border-radius: 999px;
        background: #dce2e6;
        color: var(--ink);
        text-transform: lowercase;
        border: 0;
        height: auto;
        line-height: 1.4;
      }
      .bd::first-letter {
        text-transform: uppercase;
      }
      button.bd {
        cursor: pointer;
        text-transform: none;
      }
      #bRTA {
        letter-spacing: 0.02em;
      }
      button.bd.on {
        background: var(--ink);
        color: #fff;
      }
      .acts {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
      }
      .seg {
        display: inline-flex;
        border: 1px solid var(--rule);
        border-radius: 9px;
        overflow: hidden;
        background: #fff;
      }
      .seg button {
        border: 0;
        border-radius: 0;
        border-right: 1px solid var(--rule);
        height: 34px;
        background: transparent;
      }
      .seg button:last-child {
        border-right: 0;
      }
      .seg button.on {
        background: var(--ink);
        color: #fff;
      }
      #bS {
        background: var(--ink);
        color: #fff;
      }
      #bS:hover:not(:disabled) {
        background: #243442;
      }
      .file-upload {
        display: inline-flex;
        align-items: center;
        height: 34px;
        padding: 0 12px;
        border: 1px solid var(--rule);
        border-radius: 8px;
        background: #fff;
        font-weight: 500;
        font-size: 13px;
        cursor: pointer;
        margin: 0;
      }
      .file-upload:hover {
        background: #eef1f3;
      }
      .file-upload input {
        display: none;
      }
      .file-upload:focus-within {
        outline: 2px solid var(--b);
        outline-offset: 2px;
      }
      .wrap {
        display: grid;
        grid-template-columns: minmax(340px, 5fr) 7fr;
        gap: 24px;
        padding: 20px 24px;
        max-width: 1560px;
        margin: auto;
        align-items: start;
      }
      .stagecol {
        position: sticky;
        top: 72px;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }
      @media (max-width: 980px) {
        .wrap {
          grid-template-columns: 1fr;
        }
        .stagecol {
          position: static;
        }
      }
      .stage {
        position: relative;
        aspect-ratio: 4/5;
        max-height: calc(100vh - 230px);
        min-height: 340px;
        width: 100%;
        border-radius: 16px;
        overflow: hidden;
        background: radial-gradient(
          120% 90% at 50% 25%,
          #e6eaed 0%,
          #c9d0d5 100%
        );
      }
      @media (max-width: 980px) {
        .stage {
          max-height: none;
        }
      }
      #bc {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        touch-action: pan-y;
        cursor: grab;
        display: block;
      }
      #bc:active {
        cursor: grabbing;
      }
      .stage::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 20%;
        background: linear-gradient(rgba(201, 208, 213, 0), #c9d0d5 85%);
        pointer-events: none;
      }
      .vbar {
        position: absolute;
        top: 12px;
        left: 12px;
        right: 12px;
        display: flex;
        justify-content: space-between;
        gap: 8px;
        z-index: 2;
        pointer-events: none;
      }
      .vbar .seg,
      .vbar button {
        pointer-events: auto;
      }
      .vbar button {
        height: 30px;
        font-size: 12px;
      }
      .stage-note {
        position: absolute;
        left: 14px;
        bottom: 12px;
        right: 14px;
        z-index: 2;
        font-size: 12px;
        color: #44515c;
        max-width: 46ch;
      }
      .ctlrow {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .ctl button {
        height: 30px;
        border-radius: 999px;
        font-size: 12.5px;
      }
      .sl {
        display: grid;
        grid-template-columns: 76px 1fr 44px;
        gap: 10px;
        align-items: center;
        font-size: 13px;
        color: var(--muted);
        margin-top: 4px;
      }
      .sl b {
        color: var(--ink);
        font-weight: 600;
        text-align: right;
      }
      .sheet {
        background: var(--sheet);
        border: 1px solid var(--rule);
        border-radius: 16px;
        padding: 6px 24px;
      }
      .pn {
        padding: 16px 0 18px;
        min-width: 0;
        position: relative;
      }
      .pn + .pn,
      .row2 + .pn,
      .pn + .row2,
      .row2 {
        border-top: 1px solid var(--rule2);
      }
      .row2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 32px;
      }
      .row2 > .pn {
        border-top: 0;
      }
      @media (max-width: 760px) {
        .row2 {
          grid-template-columns: 1fr;
        }
      }
      .pn h3 {
        margin: 0 0 12px;
        font: 500 19px/1.2 var(--serif);
        letter-spacing: -0.005em;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--ink);
      }
      .pn h3::after {
        content: "";
        width: 7px;
        height: 7px;
        border-right: 1.5px solid var(--muted);
        border-bottom: 1.5px solid var(--muted);
        transform: rotate(45deg) translate(-2px, -2px);
        margin-left: auto;
        transition: transform 0.15s;
      }
      .pn.cx h3 {
        margin-bottom: 0;
      }
      .pn.cx h3::after {
        transform: rotate(-45deg);
      }
      .pn.cx > *:not(h3) {
        display: none;
      }
      .stagecol .pn {
        background: var(--sheet);
        border: 1px solid var(--rule);
        border-radius: 16px;
        padding: 14px 20px 16px;
      }
      .stagecol .pn h3 {
        font-size: 17px;
      }
      canvas.rd {
        width: 100%;
        height: 240px;
        display: block;
      }
      #gauges {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 8px;
      }
      .ga {
        text-align: center;
      }
      .ga svg {
        width: 100%;
        max-width: 74px;
      }
      .gl {
        font-size: 12px;
        color: var(--muted);
        margin-top: 2px;
        line-height: 1.2;
      }
      .bx {
        display: grid;
        grid-template-columns: 58px 1fr 76px;
        gap: 10px;
        align-items: center;
        font-size: 13px;
        margin: 7px 0;
        cursor: help;
      }
      .bx > span:first-child {
        font-weight: 600;
      }
      .bx > span:last-child {
        text-align: right;
        color: var(--muted);
        font-size: 12px;
      }
      .bt {
        height: 7px;
        background: #e3e7ea;
        border-radius: 4px;
        overflow: hidden;
      }
      .bt i {
        display: block;
        height: 100%;
        width: 0;
        transition: width 0.5s;
        border-radius: 4px;
      }
      .kv {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 13px;
        color: var(--muted);
        padding: 6px 0;
        border-top: 1px solid var(--rule2);
      }
      .kv b {
        color: var(--ink);
        font-weight: 500;
        text-align: right;
      }
      #bk {
        margin-top: 10px;
      }
      .ms {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        margin-bottom: 8px;
      }
      .ms select {
        width: 100%;
      }
      .tr {
        border-top: 1px solid var(--rule2);
        padding: 9px 0;
        font-size: 13.5px;
      }
      .tr small {
        display: block;
        color: var(--muted);
        font-size: 12px;
        margin-top: 1px;
      }
      .tr a,
      .tr button {
        font-size: 12px;
        height: 26px;
        padding: 0 10px;
        color: var(--b);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        border-radius: 6px;
        margin-top: 6px;
      }
      .tr a {
        border: 1px solid var(--rule);
        background: #fff;
      }
      .tb {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 10px;
        align-items: center;
      }
      .tn {
        display: flex;
        justify-content: space-between;
        padding: 7px 0;
        border-top: 1px solid var(--rule2);
        font-size: 13.5px;
        color: var(--muted);
      }
      .tn.on {
        color: var(--ink);
        font-weight: 600;
      }
      #mpl small {
        display: block;
        margin-bottom: 8px;
        color: var(--muted);
        font-size: 12.5px;
      }
      #wv {
        width: 100%;
        height: 340px;
        display: block;
        background: #f1f4f6;
        border-radius: 10px;
        border: 1px solid var(--rule2);
      }
      #qs {
        width: 100%;
        height: 46px;
        display: block;
        margin-top: 8px;
      }
      #cd {
        font-size: 12px;
        color: var(--muted);
        margin-top: 10px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 4px 18px;
      }
      #cd b {
        color: var(--ink);
        font-weight: 500;
      }
      #tl {
        font-size: 12px;
        color: var(--muted);
        margin-top: 8px;
      }
      #mr,
      #mc {
        display: none;
      }
      #rp {
        margin: 14px 24px 0;
        max-width: 1512px;
        border: 1px solid var(--ink);
        border-radius: 14px;
        padding: 14px 20px;
        background: var(--sheet);
      }
      @media (min-width: 1608px) {
        #rp {
          margin-left: auto;
          margin-right: auto;
        }
      }
      #rp h3 {
        cursor: default;
        margin-bottom: 6px;
      }
      #rp h3::after {
        display: none;
      }
      #rp.bz {
        animation: bz 0.5s steps(2) infinite;
      }
      @keyframes bz {
        50% {
          border-color: var(--o);
          box-shadow: 0 0 0 4px rgba(168, 106, 12, 0.25);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        #rp.bz {
          animation: none;
          border-color: var(--o);
        }
      }
      .foot {
        max-width: 1512px;
        margin: 0 auto;
        padding: 6px 24px 28px;
        font-size: 12px;
        color: var(--muted);
      }
      #ms {
        position: fixed;
        left: 50%;
        bottom: calc(18px + env(safe-area-inset-bottom, 0px));
        transform: translateX(-50%);
        background: var(--ink);
        color: #fff;
        padding: 9px 16px;
        border-radius: 10px;
        display: none;
        z-index: 50;
        font-size: 13px;
        max-width: 90vw;
      }
      .tele {
        max-width: 1512px;
        margin: 0 auto 14px;
        padding: 0 24px;
      }
      .tele .sheet {
        padding-bottom: 12px;
      }
      .tele.below {
        margin-bottom: 14px;
      }
      .tele.below .row2 {
        border-top: 0;
      }
      #lf select {
        height: 44px;
        font-size: 16px;
        font-weight: 400;
        border-radius: 10px;
        padding: 0 14px;
      }
      /* ---------- cinematic landing ---------- */
      #nl {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: #05080c;
        color: #e8eef2;
        font: 16px/1.55 var(--sans);
        transition:
          opacity 0.7s ease,
          transform 0.7s ease,
          filter 0.7s ease;
      }
      #nl.nl-out {
        opacity: 0;
        transform: scale(1.05);
        filter: blur(8px);
        pointer-events: none;
      }
      #nl .nl-scroll {
        position: absolute;
        inset: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        scroll-snap-type: y proximity;
        scrollbar-width: none;
        outline: none;
      }
      #nl .nl-scroll::-webkit-scrollbar {
        display: none;
      }
      #nl .nl-inner {
        position: relative;
      }
      #nl .nl-stage {
        position: sticky;
        top: 0;
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
        background: radial-gradient(ellipse at 62% 50%, #0d1a22 0%, #05080c 70%);
      }
      #nl #nlCanvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
      }
      #nl .nl-vig {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          linear-gradient(0deg, rgba(5, 8, 12, 0.8) 0%, rgba(5, 8, 12, 0) 38%),
          linear-gradient(90deg, rgba(5, 8, 12, 0.72) 0%, rgba(5, 8, 12, 0) 46%),
          radial-gradient(ellipse at 50% 50%, transparent 45%, rgba(5, 8, 12, 0.8) 100%);
      }
      #nl .nl-lab {
        position: absolute;
        left: 0;
        top: 0;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 2px 9px 2px 7px;
        font: 600 12px/1.5 var(--sans);
        color: #e8eef2;
        background: rgba(5, 8, 12, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 999px;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        will-change: transform, opacity;
      }
      #nl .nl-lab::before {
        content: "";
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--lc, #2a8c95);
      }
      #nl .nl-secs {
        position: relative;
        margin-top: -100vh;
        margin-top: -100dvh;
      }
      #nl .nl-sec {
        height: 100vh;
        height: 100dvh;
        display: flex;
        align-items: center;
        padding: 0 clamp(24px, 7vw, 112px);
        scroll-snap-align: start;
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
      }
      #nl .nl-sec[data-i="2"] {
        align-items: flex-end;
        padding-bottom: 11vh;
      }
      #nl .nl-sec[data-i="3"] {
        align-items: flex-end;
        justify-content: center;
        text-align: center;
        padding-bottom: 12vh;
      }
      #nl .nl-copy {
        max-width: 31rem;
        pointer-events: auto;
      }
      #nl .nl-sec[data-i="3"] .nl-copy {
        max-width: 36rem;
      }
      #nl h1,
      #nl h2 {
        margin: 0 0 18px;
        font-family: var(--serif);
        font-weight: 400;
        letter-spacing: -0.025em;
        line-height: 0.98;
        color: #f2f6f8;
        text-wrap: balance;
      }
      #nl h1 {
        font-size: clamp(44px, 6.4vw, 96px);
      }
      #nl h2 {
        font-size: clamp(34px, 4.6vw, 64px);
      }
      #nl p {
        margin: 0 0 28px;
        max-width: 42ch;
        font-size: clamp(16px, 1.3vw, 19px);
        color: #a9b8c3;
      }
      #nl .nl-sec[data-i="3"] p {
        margin-left: auto;
        margin-right: auto;
      }
      #nl .nl-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px 20px;
      }
      #nl .nl-sec[data-i="3"] .nl-row {
        justify-content: center;
      }
      #nl .nl-hint {
        font-size: 13px;
        color: #7d8d99;
      }
      #nl .nl-btn {
        height: 48px;
        padding: 0 28px;
        border: 0;
        border-radius: 999px;
        background: #e8eef2;
