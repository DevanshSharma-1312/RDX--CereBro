/* --- AI Adaptive Sound Therapy Provider Styles --- */
/* ==========================================================================
   CereBro AI Adaptive Sound Therapy Provider — Stylesheet
   Neuroscience Laboratory Aesthetic: Soft white, pale blue, ice blue, primary blue, soft violet
   ========================================================================== */

:root {
  --st-bg: #F8FAFC;
  --st-card-bg: rgba(255, 255, 255, 0.88);
  --st-card-border: #E2E8F0;
  --st-pale-blue: #EAF4FF;
  --st-ice-blue: #DCEEFF;
  --st-primary-blue: #4285F4;
  --st-primary-hover: #3367D6;
  --st-soft-violet: #A78BFA;
  --st-violet-glow: rgba(167, 139, 250, 0.25);
  --st-blue-glow: rgba(66, 133, 244, 0.22);
  --st-ink: #172554;
  --st-ink-muted: #64748B;
  --st-ink-light: #94A3B8;
  --st-success: #10B981;
  --st-warning: #F59E0B;
  --st-danger: #EF4444;
  --st-radius-sm: 8px;
  --st-radius-md: 14px;
  --st-radius-lg: 20px;
  --st-shadow-subtle: 0 4px 18px rgba(23, 37, 84, 0.05);
  --st-shadow-card: 0 10px 30px rgba(23, 37, 84, 0.07), 0 1px 3px rgba(23, 37, 84, 0.03);
  --st-shadow-glow: 0 0 25px rgba(66, 133, 244, 0.28);
}

/* --- Header Mode Switcher Navigation --- */
.mode-nav-group {
  display: flex;
  align-items: center;
  background: #E2E8F0;
  border-radius: 10px;
  padding: 3px;
  gap: 2px;
  margin-left: 12px;
}
.mode-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 30px;
  padding: 0 12px;
  border-radius: 8px;
  border: none;
  background: transparent;
  color: var(--st-ink-muted);
  font-weight: 500;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}
.mode-nav-btn:hover {
  color: var(--st-ink);
  background: rgba(255, 255, 255, 0.6);
}
.mode-nav-btn.on {
  background: #FFFFFF;
  color: var(--st-ink);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  font-weight: 600;
}
.st-ai-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 700;
  padding: 1px 6px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--st-primary-blue), var(--st-soft-violet));
  color: #FFFFFF;
  letter-spacing: 0.03em;
}

/* --- EEG Sheet Promo Card --- */
.st-launch-card {
  margin-top: 14px;
  padding: 14px 16px;
  background: linear-gradient(135deg, #F0F7FF 0%, #FAF5FF 100%);
  border: 1px solid #DCEEFF;
  border-radius: var(--st-radius-md);
  display: flex;
  align-items: center;
  gap: 14px;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.st-launch-card:hover {
  border-color: #B9DCFF;
  box-shadow: var(--st-shadow-subtle);
}
.st-launch-icon {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(66, 133, 244, 0.15);
  flex-shrink: 0;
}
.st-launch-info {
  flex: 1;
}
.st-launch-info strong {
  display: block;
  font-size: 13.5px;
  color: var(--st-ink);
}
.st-launch-info p {
  margin: 2px 0 0;
  font-size: 12px;
  color: var(--st-ink-muted);
  line-height: 1.35;
}
.st-launch-btn {
  background: var(--st-primary-blue);
  color: #FFFFFF;
  border: none;
  border-radius: 8px;
  padding: 0 14px;
  height: 32px;
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s, transform 0.15s;
}
.st-launch-btn:hover {
  background: var(--st-primary-hover);
  transform: translateY(-1px);
}

/* ==========================================================================
   Sound Therapy Main View Container
   ========================================================================== */
.st-view {
  min-height: calc(100vh - 58px);
  background: linear-gradient(180deg, #F8FAFC 0%, #EAF4FF 50%, #F8FAFC 100%);
  color: var(--st-ink);
  padding: 16px clamp(16px, 2.5vw, 36px) 36px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-sizing: border-box;
}

/* --- Sound Therapy Sub-header --- */
.st-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  padding: 12px 18px;
  background: var(--st-card-bg);
  backdrop-filter: blur(14px);
  border: 1px solid var(--st-card-border);
  border-radius: var(--st-radius-md);
  box-shadow: var(--st-shadow-subtle);
}
.st-brand-title {
  display: flex;
  align-items: center;
  gap: 10px;
}
.st-brand-title h2 {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
  color: var(--st-ink);
  letter-spacing: -0.01em;
}
.st-brand-title span.sub {
  font-size: 12.5px;
  color: var(--st-ink-muted);
  font-weight: 400;
}

/* --- Workflow Step Tabs --- */
.st-steps-nav {
  display: flex;
  align-items: center;
  background: #F1F5F9;
  padding: 3px;
  border-radius: 10px;
  gap: 2px;
}
.st-step-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 28px;
  padding: 0 12px;
  border-radius: 7px;
  border: none;
  background: transparent;
  color: var(--st-ink-muted);
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s;
}
.st-step-btn.active {
  background: #FFFFFF;
  color: var(--st-primary-blue);
  font-weight: 600;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
}
.st-step-btn.completed {
  color: var(--st-ink);
}
.st-step-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

/* --- Utility Actions (History & API Key) --- */
.st-header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}
.st-pill-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 28px;
  padding: 0 11px;
  border-radius: 14px;
  border: 1px solid var(--st-card-border);
  background: #FFFFFF;
  color: var(--st-ink);
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s;
}
.st-pill-btn:hover {
  border-color: #CBD5E1;
  background: #F8FAFC;
}
.st-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--st-success);
}
.st-dot.warning {
  background: var(--st-warning);
}

/* ==========================================================================
   STEP 1: Report Upload & File Extraction
   ========================================================================== */
.st-upload-container {
  max-width: 900px;
  margin: 20px auto 40px;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.st-welcome-card {
  text-align: center;
  padding: 10px 20px;
}
.st-welcome-card h1 {
