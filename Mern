  flex-shrink: 0;
}
.st-sample-desc span {
  font-size: 13px;
  color: var(--st-ink-muted);
}
.st-btn-sample {
  height: 32px;
  padding: 0 14px;
  border-radius: 8px;
  background: #EAF4FF;
  color: var(--st-primary-blue);
  border: 1px solid #D0E4FF;
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;
}
.st-btn-sample:hover {
  background: #DCEEFF;
}

/* Scientific Disclaimer Footer Banner */
.st-disclaimer-banner {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--st-card-border);
  border-radius: var(--st-radius-sm);
  padding: 10px 14px;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 12px;
  color: var(--st-ink-muted);
