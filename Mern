}

/* Sample Report Quick Load Bar */
.st-sample-box {
  background: #FFFFFF;
  border: 1px solid var(--st-card-border);
  border-radius: var(--st-radius-md);
  padding: 12px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
