   ========================================================================== */
.st-analysis-container {
  max-width: 1100px;
  margin: 10px auto 40px;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Summary Card */
.st-card {
  background: var(--st-card-bg);
  backdrop-filter: blur(14px);
  border: 1px solid var(--st-card-border);
  border-radius: var(--st-radius-md);
  padding: 20px 24px;
  box-shadow: var(--st-shadow-card);
}
.st-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}
.st-card-header h3 {
  margin: 0;
  font-size: 15px;
  font-weight: 600;
  color: var(--st-ink);
  display: flex;
  align-items: center;
  gap: 8px;
}
.st-summary-text {
  font-size: 14px;
  color: var(--st-ink);
  line-height: 1.6;
  margin: 0 0 14px;
}
.st-pattern-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.st-pattern-tag {
  font-size: 12px;
  font-weight: 500;
  background: #EAF4FF;
  color: var(--st-primary-blue);
  border: 1px solid #D0E4FF;
  padding: 4px 10px;
  border-radius: 6px;
