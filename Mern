  class WaveVisualizer {
    constructor(canvas) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d');
      this.analyser = null;
      this.timeData = new Uint8Array(128);
      this.bands = [
        { name: 'Gamma', range: '30–50 Hz', color: '#C2402C', freq: 36, speed: 0.18 },
        { name: 'Beta',  range: '13–30 Hz', color: '#A86A0C', freq: 22, speed: 0.12 },
        { name: 'Alpha', range: '8–12 Hz',  color: '#2F7D45', freq: 10, speed: 0.08 },
        { name: 'Theta', range: '4–8 Hz',   color: '#2A8C95', freq: 6,  speed: 0.05 },
        { name: 'Delta', range: '0.5–4 Hz', color: '#4A5BA8', freq: 2,  speed: 0.03 }
      ];
      this.phase = 0;
      this.rafId = null;
      this.init();
    }

    init() {
      this.onResize();
      window.addEventListener('resize', () => this.onResize());
      this.animate();
    }

    onResize() {
      if (!this.canvas) return;
      const rect = this.canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      this.canvas.width = rect.width * dpr;
      this.canvas.height = rect.height * dpr;
      this.ctx.scale(dpr, dpr);
      this.cssWidth = rect.width;
      this.cssHeight = rect.height;
    }

    connectAudioAnalyser(analyser) {
      this.analyser = analyser;
    }

    animate() {
      this.rafId = requestAnimationFrame(() => this.animate());

      const w = this.cssWidth || 600;
      const h = this.cssHeight || 110;
      this.ctx.clearRect(0, 0, w, h);

      let audioLevel = 0.2;
      if (this.analyser) {
        this.analyser.getByteTimeDomainData(this.timeData);
        let sum = 0;
        for (let i = 0; i < 32; i++) {
          sum += Math.abs(this.timeData[i] - 128);
        }
        audioLevel = 0.15 + (sum / 32) / 128 * 0.85;
      }

      this.phase += 0.03;

      const trackHeight = h / this.bands.length;

      this.bands.forEach((b, idx) => {
        const centerY = idx * trackHeight + trackHeight / 2;

        // Band Label
        this.ctx.font = '600 9.5px "Schibsted Grotesk", sans-serif';
        this.ctx.fillStyle = b.color;
        this.ctx.fillText(`${b.name} (${b.range})`, 10, centerY - 2);

        // Sinusoidal Wave Trace
        this.ctx.beginPath();
        this.ctx.strokeStyle = b.color;
        this.ctx.lineWidth = 1.3;
        this.ctx.globalAlpha = 0.85;

        const startX = 110;
        const waveWidth = w - startX - 14;

        for (let x = 0; x <= waveWidth; x += 3) {
          const t = (x / waveWidth) * Math.PI * 2 * (b.freq * 0.4);
          const amp = 6.0 * audioLevel;
          const y = centerY + Math.sin(t + this.phase * (b.speed * 80)) * amp;
          if (x === 0) {
            this.ctx.moveTo(startX + x, y);
          } else {
            this.ctx.lineTo(startX + x, y);
          }
        }
        this.ctx.stroke();
      });

      this.ctx.globalAlpha = 1.0;
    }

    dispose() {
      if (this.rafId) cancelAnimationFrame(this.rafId);
    }
  }


