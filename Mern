    }

    logSession(session) {
      // Sensitive report text is explicitly excluded from storage!
      const record = {
        id: 'SES-' + Date.now().toString(36).toUpperCase(),
        date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
        time: new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }),
        profile: session.profile || 'Custom AI',
        audioType: session.audioType || 'binaural',
        carrierHz: session.carrierHz || 174,
        beatHz: session.beatHz || 5.5,
        durationMinutes: session.durationMinutes || 15,
        completed: Boolean(session.completed)
      };

      const history = this.getAll();
      history.unshift(record);
      // Keep most recent 50 sessions
      if (history.length > 50) history.pop();

      try {
        localStorage.setItem(this.STORAGE_KEY, JSON.stringify(history));
      } catch (e) {}
      return record;
    }

    clear() {
      localStorage.removeItem(this.STORAGE_KEY);
    }

    getStats() {
      const all = this.getAll();
      const totalSessions = all.length;
      const completed = all.filter(s => s.completed).length;
      const totalMinutes = all.reduce((acc, cur) => acc + (cur.durationMinutes || 0), 0);

      const hours = Math.floor(totalMinutes / 60);
      const mins = totalMinutes % 60;
      const totalTimeFormatted = hours > 0 ? `${hours}h ${mins}m` : `${mins}m`;

      return { totalSessions, completed, totalTimeFormatted, recent: all.slice(0, 10) };
    }
  }


