  align-items: center;
  gap: 6px;
  font-size: 14px;
  font-weight: 700;
  color: var(--st-primary-blue);
}
.st-param-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12.5px;
}
.st-param-table td {
  padding: 6px 0;
  border-bottom: 1px solid #F1F5F9;
}
.st-param-table td.label {
  color: var(--st-ink-muted);
}
.st-param-table td.val {
  text-align: right;
  font-weight: 600;
  color: var(--st-ink);
}

/* Action Bar */
.st-confirm-bar {
  background: var(--st-card-bg);
  border: 1px solid var(--st-card-border);
  border-radius: var(--st-radius-md);
  padding: 16px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14px;
  box-shadow: var(--st-shadow-subtle);
}
.st-btn-confirm {
  background: linear-gradient(135deg, var(--st-primary-blue), #3B82F6);
  color: #FFFFFF;
  border: none;
  border-radius: 10px;
  padding: 0 24px;
  height: 42px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 4px 14px rgba(66, 133, 244, 0.28);
  transition: all 0.18s;
}
.st-btn-confirm:hover {
  background: linear-gradient(135deg, #3367D6, #2563EB);
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(66, 133, 244, 0.35);
}

/* ==========================================================================
   STEP 3: Premium 3D Sound Therapy Player (Panoramic 3-Column Studio)
   ========================================================================== */
.st-player-layout {
  display: grid;
  grid-template-columns: minmax(290px, 320px) minmax(420px, 1fr) minmax(290px, 320px);
  gap: 16px;
  align-items: start;
  width: 100%;
}
@media (max-width: 1200px) {
  .st-player-layout {
    grid-template-columns: 320px 1fr;
  }
  .st-player-layout .st-col-right {
    grid-column: 1 / -1;
  }
}
@media (max-width: 860px) {
  .st-player-layout {
    grid-template-columns: 1fr;
  }
}

/* Left & Right Player Columns */
.st-col-left, .st-col-right {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* Section Box Inside Column */
.st-box {
  background: var(--st-card-bg);
  backdrop-filter: blur(14px);
  border: 1px solid var(--st-card-border);
  border-radius: var(--st-radius-md);
  padding: 16px;
  box-shadow: var(--st-shadow-subtle);
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.st-box-title {
  margin: 0;
  font-size: 13.5px;
  font-weight: 600;
  color: var(--st-ink);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* Profile Selector */
.st-profile-selector {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.st-profile-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  border-radius: 8px;
  border: 1px solid var(--st-card-border);
  background: #FFFFFF;
  cursor: pointer;
  font-size: 12.5px;
  font-weight: 500;
  color: var(--st-ink);
  transition: all 0.15s;
}
.st-profile-chip:hover {
  background: #F8FAFC;
  border-color: #CBD5E1;
}
.st-profile-chip.selected {
  background: #EAF4FF;
  border-color: var(--st-primary-blue);
  color: var(--st-primary-blue);
  font-weight: 600;
}
.st-profile-chip .badge {
  font-size: 10.5px;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 4px;
  background: rgba(66, 133, 244, 0.12);
  color: var(--st-primary-blue);
}

/* Audio Type Radio Buttons */
.st-types-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}
.st-type-btn {
  height: 32px;
  border-radius: 7px;
  border: 1px solid var(--st-card-border);
  background: #FFFFFF;
  font-size: 12px;
  font-weight: 500;
  color: var(--st-ink-muted);
  cursor: pointer;
  transition: all 0.15s;
}
.st-type-btn.active {
  background: var(--st-ink);
  color: #FFFFFF;
  border-color: var(--st-ink);
  font-weight: 600;
}

/* Sliders */
.st-slider-control {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.st-slider-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 12px;
  color: var(--st-ink-muted);
}
.st-slider-val {
  font-weight: 600;
  color: var(--st-ink);
  font-family: monospace;
}
.st-slider-control input[type="range"] {
  width: 100%;
  accent-color: var(--st-primary-blue);
  cursor: pointer;
}
.st-quick-chips {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
  margin-top: 2px;
}
.st-chip-sm {
  font-size: 10.5px;
  padding: 2px 7px;
  border-radius: 5px;
  border: 1px solid #E2E8F0;
  background: #FFFFFF;
  color: var(--st-ink-muted);
  cursor: pointer;
  transition: all 0.12s;
}
.st-chip-sm:hover, .st-chip-sm.active {
  background: #EAF4FF;
  border-color: var(--st-primary-blue);
  color: var(--st-primary-blue);
}

/* Headphone Warning */
.st-headphone-note {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #FFFBEB;
  border: 1px solid #FDE68A;
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 11.5px;
  color: #92400E;
  line-height: 1.3;
}

/* Center Column: 3D Stage & Live Brainwaves */
.st-col-center {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.st-stage-3d {
  background: #0B111A;
  border-radius: var(--st-radius-lg);
  overflow: hidden;
  position: relative;
  box-shadow: 0 16px 40px rgba(11, 17, 26, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.08);
  height: 480px;
  min-height: 420px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.st-brain-canvas {
  width: 100%;
  height: 100%;
  display: block;
  cursor: grab;
}
.st-brain-canvas:active {
  cursor: grabbing;
}

/* Stage Overlay Controls */
.st-stage-overlay {
  position: absolute;
  top: 14px;
  left: 16px;
  right: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  pointer-events: none;
}
.st-stage-overlay > * {
  pointer-events: auto;
}
.st-stage-badge {
  background: rgba(15, 23, 42, 0.7);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #E2E8F0;
  font-size: 11.5px;
  font-weight: 500;
  padding: 4px 10px;
  border-radius: 20px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.st-pulse-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #60A5FA;
  box-shadow: 0 0 8px #60A5FA;
  animation: st-pulse 1.8s infinite;
}
@keyframes st-pulse {
  0%, 100% { opacity: 0.4; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.2); }
}
.st-stage-tools {
  display: flex;
  gap: 6px;
}
.st-tool-btn {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(8px);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.15s;
}
.st-tool-btn:hover {
  background: rgba(255, 255, 255, 0.18);
}

/* Live Brainwave Canvas Container */
.st-waves-container {
  background: #FFFFFF;
  border: 1px solid var(--st-card-border);
  border-radius: var(--st-radius-md);
  padding: 14px 16px;
  box-shadow: var(--st-shadow-subtle);
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.st-waves-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.st-waves-title {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--st-ink);
  display: flex;
  align-items: center;
  gap: 6px;
}
.st-waves-honesty {
  font-size: 11px;
  font-weight: 500;
  color: var(--st-ink-muted);
  background: #F1F5F9;
  padding: 2px 8px;
  border-radius: 6px;
}
.st-waves-canvas {
  width: 100%;
  height: 110px;
  display: block;
  border-radius: 6px;
  background: #F8FAFC;
}

/* Right Column: Telemetry & Audio Transport */
.st-timer-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px 16px;
  text-align: center;
}
.st-timer-ring-wrap {
  width: 140px;
  height: 140px;
  position: relative;
  margin-bottom: 12px;
}
.st-timer-svg {
  transform: rotate(-90deg);
  width: 100%;
  height: 100%;
}
.st-timer-circle-bg {
  fill: none;
  stroke: #E2E8F0;
  stroke-width: 6;
}
.st-timer-circle-prog {
  fill: none;
  stroke: var(--st-primary-blue);
  stroke-width: 6;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.5s ease;
}
.st-timer-digital {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.st-timer-digits {
  font-family: monospace;
  font-size: 26px;
  font-weight: 700;
  color: var(--st-ink);
  letter-spacing: -0.02em;
}
.st-timer-label {
  font-size: 11px;
  color: var(--st-ink-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-weight: 600;
}

/* Transport Buttons */
.st-transport-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-top: 8px;
  width: 100%;
}
.st-btn-play {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--st-primary-blue), #2563EB);
  color: #FFFFFF;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(66, 133, 244, 0.35);
  transition: all 0.18s;
}
.st-btn-play:hover {
  transform: scale(1.05);
  box-shadow: 0 6px 22px rgba(66, 133, 244, 0.45);
}
.st-btn-stop {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: #F1F5F9;
  border: 1px solid var(--st-card-border);
  color: var(--st-ink-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.15s;
}
.st-btn-stop:hover {
  background: #E2E8F0;
  color: var(--st-ink);
}

/* Telemetry Stats Card */
.st-tele-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 0;
  border-bottom: 1px solid #F1F5F9;
  font-size: 12.5px;
}
.st-tele-row:last-child {
  border-bottom: none;
}
.st-tele-label {
  color: var(--st-ink-muted);
}
.st-tele-val {
  font-weight: 600;
  color: var(--st-ink);
  font-family: monospace;
}

/* ==========================================================================
   Modals: Session History & Gemini API Key
   ========================================================================== */
.st-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.4);
  backdrop-filter: blur(6px);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.st-modal-card {
  background: #FFFFFF;
  border: 1px solid var(--st-card-border);
  border-radius: var(--st-radius-lg);
  box-shadow: 0 25px 60px rgba(15, 23, 42, 0.2);
  max-width: 580px;
  width: 100%;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: st-pop 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes st-pop {
  from { transform: scale(0.95); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.st-modal-header {
  padding: 18px 24px;
  border-bottom: 1px solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.st-modal-header h3 {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
  color: var(--st-ink);
}
.st-modal-close {
  background: transparent;
  border: none;
  font-size: 18px;
  color: var(--st-ink-muted);
  cursor: pointer;
  padding: 4px;
}
.st-modal-body {
  padding: 20px 24px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.st-modal-footer {
  padding: 14px 24px;
  border-top: 1px solid #E2E8F0;
  background: #F8FAFC;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
}

/* History Stats Grid */
.st-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.st-stat-box {
  background: #F8FAFC;
  border: 1px solid var(--st-card-border);
  border-radius: 8px;
  padding: 12px;
  text-align: center;
}
.st-stat-box .num {
  font-size: 20px;
  font-weight: 700;
  color: var(--st-primary-blue);
  display: block;
}
.st-stat-box .lbl {
  font-size: 11px;
  color: var(--st-ink-muted);
}
.st-history-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}
.st-history-table th {
  text-align: left;
  padding: 8px;
  border-bottom: 1px solid #CBD5E1;
  color: var(--st-ink-muted);
  font-weight: 600;
}
.st-history-table td {
  padding: 8px;
  border-bottom: 1px solid #F1F5F9;
  color: var(--st-ink);
}

/* Fullscreen Studio Mode */
.st-view.fullscreen-mode {
  position: fixed;
  inset: 0;
  z-index: 9990;
  margin: 0;
  border-radius: 0;
  overflow-y: auto;
}

/* Responsive adjustments */
@media (max-width: 640px) {
  .st-header {
    flex-direction: column;
    align-items: stretch;
  }
  .st-steps-nav {
    justify-content: center;
  }
  .st-stage-3d {
    height: 340px;
    min-height: 300px;
  }
}

