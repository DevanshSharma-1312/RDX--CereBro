}

/* Primary Analysis Action Button */
.st-btn-analyse {
  background: linear-gradient(135deg, var(--st-primary-blue) 0%, #3B82F6 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 10px;
  height: 44px;
  font-size: 14.5px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 14px rgba(66, 133, 244, 0.28);
  width: 100%;
}
.st-btn-analyse:hover:not(:disabled) {
  background: linear-gradient(135deg, #3367D6 0%, #2563EB 100%);
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(66, 133, 244, 0.38);
}
.st-btn-analyse:disabled {
