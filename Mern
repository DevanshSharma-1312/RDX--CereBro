}
.st-disclaimer-banner svg {
  color: var(--st-primary-blue);
  flex-shrink: 0;
  margin-top: 1px;
}

/* ==========================================================================
   Loading Overlay Animation
   ========================================================================== */
.st-loading-overlay {
  position: fixed;
  inset: 0;
  background: rgba(248, 250, 252, 0.88);
  backdrop-filter: blur(12px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.st-loading-card {
  background: #FFFFFF;
  border: 1px solid var(--st-card-border);
  border-radius: var(--st-radius-lg);
  padding: 36px 40px;
  text-align: center;
  box-shadow: 0 20px 50px rgba(23, 37, 84, 0.14);
  max-width: 440px;
  width: 90%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}
.st-spinner-brain {
  width: 72px;
  height: 72px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.st-spinner-ring {
  position: absolute;
  inset: 0;
  border: 3px solid #E2E8F0;
  border-top-color: var(--st-primary-blue);
  border-right-color: var(--st-soft-violet);
  border-radius: 50%;
  animation: st-spin 1.2s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;
}
@keyframes st-spin {
  to { transform: rotate(360deg); }
}
.st-loading-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--st-ink);
  margin: 0;
}
.st-loading-step {
  font-size: 13.5px;
  color: var(--st-ink-muted);
  min-height: 20px;
  transition: opacity 0.2s;
}

/* ==========================================================================
